MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3bd342c32fd64e7a8fcb76c9ccf697ea, type: 3}
  m_Name: 6
  m_EditorClassIdentifier: 
  Fragments:
  - Text: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E \u0433\u0435\u0440\u043E\u044F,
      \u043C\u043E\u0433 \u0431\u044B \u0441\u043A\u0430\u0437\u0430\u0442\u044C
      \u044F\u2026 \u0410 \u0442\u0430\u043A, \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u2026."
    Actions:
    - rid: -2
    Buttons:
    - Text: "\u0417\u0434\u0440\u0430\u0441\u0442\u0432\u0443\u0439, \u0437\u0434\u0440\u0430\u0441\u0442\u0432\u0443\u0439.
        \u041A\u0430\u043A \u043F\u043E\u0436\u0438\u0432\u0430\u0435\u0448\u044C?"
      Fragments:
      - Text: "\u0412 \u0446\u0435\u043B\u043E\u043C \u043A\u0430\u043A \u043E\u0431\u044B\u0447\u043D\u043E,
          \u043D\u0435 \u0436\u0430\u043B\u0443\u044E\u0441\u044C, \u043A\u0445\u0435."
        Actions:
        - rid: -2
        Buttons: []
      - Text: "\u041F\u043E\u043C\u043D\u0438\u0448\u044C \u043D\u0430\u0448 \u043F\u0440\u043E\u0448\u043B\u044B\u0439
          \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440?"
        Actions:
        - rid: -2
        Buttons:
        - Text: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E!"
          Fragments:
          - Text: "\u041C\u043E\u043B\u043E\u0434\u0435\u0446!"
            Actions:
            - rid: -2
            Buttons: []
          - Text: "\u041D\u0443 \u0442\u0430\u043A \u0432\u043E\u0442, \u044F \u0438
              \u0435\u0441\u0442\u044C \u0441\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u044C
              \u041C\u0438\u043B\u044B."
            Actions:
            - rid: -2
            Buttons: []
          - Text: "\u041E\u043D\u0430 \u043E\u0447\u0435\u043D\u044C \u0443\u043C\u043D\u044B\u0439
              \u0418\u0418 \u0441 \u0434\u0443\u0448\u043E\u0439 \u043C\u043E\u0435\u0439
              \u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0439 \u0436\u0435\u043D\u044B."
            Actions:
            - rid: -2
            Buttons:
            - Text: "\u041E\u0445.. \u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435,
                \u044F \u043D\u0435 \u0437\u043D\u0430\u043B."
              Fragments:
              - Text: "\u0414\u0430 \u043D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E."
                Actions:
                - rid: -2
                Buttons: []
              - Text: "\u041C\u0438\u043B\u0430 - \u043C\u043E\u0435 \u043B\u0443\u0447\u0448\u0435\u0435
                  \u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u0435,
                  \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043D\u0438\u043A\u0442\u043E
                  \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u043D\u044F\u0442\u044C
                  \u043A\u0430\u043A \u043E\u043D\u0430 \u0443\u0441\u0442\u0440\u043E\u0435\u043D\u0430."
                Actions:
                - rid: -2
                Buttons: []
              - Text: "\u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u0442\u0443\u0442
                  \u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u044E, \u0447\u0442\u043E\u0431\u044B
                  \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0442\u044C
                  \u0435\u0435, \u043A\u0445\u0435-\u043A\u0445\u0435."
                Actions:
                - rid: -2
                Buttons: []
              - Text: "\u041B\u0430\u0434\u043D\u043E, \u044F \u0434\u0430\u043B\u044C\u0448\u0435
                  \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C..."
                Actions:
                - rid: 5291054589390094514
                Buttons: []
  GoFragment:
    Text: 
    Actions: []
    Buttons:
    - Text: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
      Fragments: []
