  Fragments:
  - Text: "\u0417\u0434\u043E\u0440\u043E\u0432\u043E, \u041E\u0440\u0438\u043E\u043D!"
    Actions:
    - rid: -2
    Buttons: []
  - Text: "\u042F \u0442\u0443\u0442 \u043A \u0442\u0435\u0431\u0435 \u043F\u043E
      \u0434\u0435\u043B\u0443 \u0437\u0430\u0441\u043A\u043E\u0447\u0438\u043B."
    Actions:
    - rid: -2
    Buttons:
    - Text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
        \u041C\u0430\u0440\u043A\u0443\u0441."
      Fragments:
      - Text: "\u0423 \u043D\u0430\u0441 \u0442\u0443\u0442 \u0443\u0436\u0435\u0441\u0442\u043E\u0447\u0438\u043B\u0438\u0441\u044C
          \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430
          \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u0439. \u0422\u0435\u043F\u0435\u0440\u044C
          \u043C\u0435\u0434\u0432\u0435\u0434\u0438 \u0434\u043E\u043B\u0436\u043D\u044B
          \u0438\u043C\u0435\u0442\u044C \u043F\u0440\u0438 \u0441\u0435\u0431\u0435
          \u0438\u043D\u043E\u043F\u043B\u0430\u043D\u0435\u0442\u043D\u043E\u0435
          \u0443\u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u0435\u043D\u0438\u0435."
        Actions:
        - rid: -2
        Buttons: []
      - Text: "\u0422\u0435\u0431\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
          \u0441\u0432\u0435\u0440\u044F\u0442\u044C \u0438\u0445 ID \u0441 \u0442\u0435\u043C,
          \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0443\u043A\u0430\u0437\u0430\u043D
          \u0432 \u0431\u0430\u0437\u0435 \u0434\u0430\u043D\u043D\u044B\u0445 \u043D\u0430
          \u043F\u0440\u0430\u0432\u043E\u043C \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u0435. "
        Actions: []
        Buttons: []
      - Text: "\u0414\u043E \u0441\u043A\u043E\u0440\u043E\u0433\u043E."
        Actions:
        - rid: 5291054589390094510
        Buttons: []
