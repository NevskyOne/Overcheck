--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3bd342c32fd64e7a8fcb76c9ccf697ea, type: 3}
  m_Name: 2
  m_EditorClassIdentifier: 
  Fragments:
  - Text: "\u0417\u0434\u043E\u0440\u043E\u0432\u043E, \u041E\u0440\u0438\u043E\u043D!"
    Actions:
    - rid: -2
    Buttons: []
  - Text: "\u042F \u0442\u0443\u0442 \u043A \u0442\u0435\u0431\u0435 \u043F\u043E
      \u0434\u0435\u043B\u0443 \u0437\u0430\u0441\u043A\u043E\u0447\u0438\u043B."
    Actions:
    - rid: -2
    Buttons:
    - Text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
        \u041C\u0430\u0440\u043A\u0443\u0441."
      Fragments:
      - Text: "\u0423 \u043D\u0430\u0441 \u0442\u0443\u0442 \u0443\u0436\u0435\u0441\u0442\u043E\u0447\u0438\u043B\u0438\u0441\u044C
          \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430
          \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u0439."
        Actions:
        - rid: -2
        Buttons: []
      - Text: "\u0420\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E
          \u043F\u0440\u0438\u0441\u043B\u0430\u043B\u043E \u043D\u043E\u0432\u044B\u0435
          \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438."
        Actions:
        - rid: -2
        Buttons:
        - Text: "\u0412\u0430\u043C \u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
            \u0447\u0442\u043E \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
            \u0442\u0430\u043A \u0440\u0435\u0437\u043A\u043E \u043C\u0435\u043D\u044F\u0442\u044C
            \u043F\u0440\u0430\u0432\u0438\u043B\u0430?"
          Fragments:
          - Text: "\u041F\u0440\u0438\u043A\u0430\u0437\u044B \u0448\u0442\u0430\u0431\u0430
              \u043D\u0435 \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u044E\u0442\u0441\u044F!!"
            Actions:
            - rid: -2
            Buttons: []
          - Text: "\u0422\u044B \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C
              \u0432\u0441\u044E \u041E\u0422\u0412\u0415\u0422\u0421\u0422\u0412\u0415\u041D\u041D\u041E\u0421\u0422\u042C
              \u0441\u0432\u043E\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u044B,
              \u043C\u0430\u043B\u0435\u0446."
            Actions:
            - rid: -2
            Buttons:
            - Text: "\u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438\u0442\u0435
                \u0447\u0442\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C."
              Fragments:
              - Text: "\u0422\u0435\u043F\u0435\u0440\u044C \u043C\u0435\u0434\u0432\u0435\u0434\u0438
                  \u0434\u043E\u043B\u0436\u043D\u044B \u0438\u043C\u0435\u0442\u044C
                  \u043F\u0440\u0438 \u0441\u0435\u0431\u0435 \u0438\u043D\u043E\u043F\u043B\u0430\u043D\u0435\u0442\u043D\u043E\u0435
                  \u0443\u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u0435\u043D\u0438\u0435."
                Actions:
                - rid: -2
                Buttons: []
              - Text: "\u0422\u0435\u0431\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
                  \u0441\u0432\u0435\u0440\u044F\u0442\u044C \u0438\u0445 ID \u0441
                  \u0442\u0435\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
                  \u0443\u043A\u0430\u0437\u0430\u043D \u0432 \u0431\u0430\u0437\u0435
                  \u0434\u0430\u043D\u043D\u044B\u0445 \u043D\u0430 \u043F\u0440\u0430\u0432\u043E\u043C
                  \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u0435."
                Actions:
                - rid: -2
                Buttons: []
              - Text: "\u0418 \u0434\u0430, \u0443 \u043D\u0430\u0441 \u0442\u0435\u043F\u0435\u0440\u044C
                  \u0435\u0441\u0442\u044C \u0441\u0435\u0440\u0432\u0435\u0440,
                  \u043E\u043D \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0439,
                  \u0442\u0430\u043A \u0447\u0442\u043E \u0438\u043D\u043E\u0433\u0434\u0430
                  \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
                  \u0435\u0433\u043E \u043D\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C."
                Actions:
                - rid: -2
                Buttons:
                - Text: "\u0410\u0433\u0430, \u043E\u043F\u044F\u0442\u044C \u043C\u043D\u0435\u2026"
                  Fragments:
                  - Text: "\u041D\u0435 \u0436\u0430\u043B\u0443\u0439\u0441\u044F!
                      \u0411\u0443\u0434\u044C \u044F \u043D\u0430 \u0442\u0432\u043E\u0451\u043C
                      \u043C\u0435\u0441\u0442\u0435, \u044F \u0440\u0430\u0431\u043E\u0442\u0430\u043B
                      \u0431\u044B \u043A\u0443\u0434\u0430 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0435\u0435\u2026"
                    Actions:
                    - rid: -2
                    Buttons: []
                  - Text: "\u0414\u043E \u0441\u043A\u043E\u0440\u043E\u0433\u043E."
                    Actions:
                    - rid: 5624657917953179729
                    Buttons: []
  GoFragment:
    Text: 
    Actions: []
    Buttons:
    - Text: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
      Fragments: []
