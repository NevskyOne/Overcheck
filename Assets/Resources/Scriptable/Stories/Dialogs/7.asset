MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3bd342c32fd64e7a8fcb76c9ccf697ea, type: 3}
  m_Name: 7
  m_EditorClassIdentifier: 
  Fragments:
  - Text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
      \u041E\u0440\u0438\u043E\u043D."
    Actions:
    - rid: -2
    Buttons:
    - Text: "3\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
        \u044F \u0432\u0430\u0441 \u0437\u043D\u0430\u044E?"
      Fragments:
      - Text: "H\u0435m, \u043D\u043E \u041C\u042B \u0437\u043D\u0430\u0435\u043C
          \u0442\u0435\u0431\u044F."
        Actions:
        - rid: -2
        Buttons: []
      - Text: "\u0412 \u0446\u0435\u043B\u044F\u0445 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
          \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u043D\u0438\u0447\u0435\u0433\u043E
          \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u043D\u043E
          \u044F \u043F\u0440\u0438\u043D\u0435\u0441 \u0432\u0430\u043C \u043F\u0438\u0441\u044C\u043C\u043E."
        Actions:
        - rid: -2
        Buttons:
        - Text: "\u0412\u044B \u0437\u0432\u0443\u0447\u0438\u0442\u0435 \u043E\u0447\u0435\u043D\u044C
            \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u2026"
          Fragments:
          - Text: "\u041D\u0430\u0448\u0430 \u0440\u0430\u0431\u043E\u0442\u0430
              \u043E\u0447\u0435\u043D\u044C \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u0430,
              \u043D\u043E \u043C\u044B \u0445\u043E\u0442\u0438\u043C \u043D\u0430\u0439\u0442\u0438
              \u0435\u0434\u0438\u043D\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u0438\u043A\u043E\u0432."
            Actions:
            - rid: -2
            Buttons: []
          - Text: "\u041C\u044B \u0434\u0430\u0434\u0438\u043C \u0432\u0430\u043C
              \u0448\u0430\u043D\u0441 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
              \u043C\u0438\u0440."
            Actions:
            - rid: -2
            Buttons:
            - Text: "\u0425\u043E\u0440\u043E\u0448\u043E, \u044F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044E."
              Fragments:
              - Text: "\u0414\u043E \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F
                  \u0438 \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u0434\u043D\u044F."
                Actions:
                - rid: -2
                Buttons: []
              - Text: "\u0417\u0430 \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u044C!"
                Actions:
                - rid: -2
                Buttons: []
  GoFragment:
    Text: 
    Actions: []
    Buttons:
    - Text: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
      Fragments: []
  BackFragment:
    Text: 
    Actions: []
    Buttons:
    - Text: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
      Fragments: []
