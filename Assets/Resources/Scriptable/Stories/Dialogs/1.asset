%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3bd342c32fd64e7a8fcb76c9ccf697ea, type: 3}
  m_Name: 1
  m_EditorClassIdentifier: 
  Fragments:
  - Text: "\u041D\u0443 \u0447\u0442\u043E, \u043A\u0430\u043A \u0442\u0435\u0431\u0435
      \u043A\u043E\u043C\u043D\u0430\u0442\u0443\u0448\u043A\u0430?"
    Actions:
    - rid: -2
    Buttons:
    - Text: "\u0412\u043F\u043E\u043B\u043D\u0435 \u043D\u0435\u043F\u043B\u043E\u0445\u043E."
      Fragments:
      - Text: "\u041D\u0443 \u044D\u0442 \u0445\u043E\u0440\u043E\u0448\u043E."
        Actions:
        - rid: -2
        Buttons: []
      - Text: "\u041B\u0430\u0434\u043D\u043E, \u0437\u043E\u0432\u0443\u0442-\u0442\u043E
          \u0442\u0435\u0431\u044F \u043A\u0430\u043A?"
        Actions:
        - rid: -2
        Buttons:
        - Text: "\u042F \u041E\u0440\u0438\u043E\u043D. \u041E\u0440\u0438\u043E\u043D
            \u041B\u044C\u044E\u043A\u0441."
          Fragments:
          - Text: "\u041D\u0435\u043E\u0431\u044B\u0447\u043D\u043E\u0435 \u0438\u043C\u044F."
            Actions:
            - rid: -2
            Buttons: []
          - Text: "\u0410 \u043C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442
              \u041C\u0430\u0440\u043A\u0443\u0441 \u0424\u0440\u0435\u0439."
            Actions:
            - rid: -2
            Buttons: []
          - Text: "\u0422\u044B \u0443\u0436\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u043B
              \u043D\u0430 \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0445 \u0440\u0430\u0431\u043E\u0442\u0430\u0445
              \u0438\u043B\u0438 \u0442\u0435\u0431\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C
              \u0447\u0442\u043E \u043A \u0447\u0435\u043C\u0443?"
            Actions:
            - rid: -2
            Buttons:
            - Text: "\u0414\u0430, \u0440\u0430\u0431\u043E\u0442\u0430\u043B."
              Fragments:
              - Text: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E, \u0442\u043E\u0433\u0434\u0430
                  \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0430\u0439 \u043A \u0440\u0430\u0431\u043E\u0442\u0435!"
                Actions:
                - rid: -2
                Buttons:
                - Text: "\u041D\u0435\u0442, \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0438\u0442\u0435."
                  Fragments:
                  - Text: "\u0425\u043E\u0440\u043E\u0448\u043E. \u041A\u0430\u043A\u0430\u044F
                      \u043E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0437\u0430\u0434\u0430\u0447\u0430
                      \u0432\u0430\u0445\u0442\u0435\u0440\u0430? \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E,
                      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B!"
                    Actions:
                    - rid: -2
                    Buttons: []
                  - Text: "\u041A \u0442\u0435\u0431\u0435 \u0431\u0443\u0434\u0443\u0442
                      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442\u044C \u043C\u0435\u0434\u0432\u0435\u0434\u0438
                      \u0438 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C
                      \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435
                      \u043D\u0430 \u043F\u043E\u0441\u0430\u0434\u043A\u0443, \u0442\u044B
                      \u0434\u043E\u043B\u0436\u0435\u043D \u0441\u0432\u0435\u0440\u044F\u0442\u044C
                      \u0438\u0445 \u0444\u043E\u0442\u043E \u0441 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u043C."
                    Actions:
                    - rid: -2
                    Buttons: []
                  - Text: "\u0422\u0430\u043A\u0436\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0439,
                      \u0447\u0442\u043E\u0431\u044B \u0438\u0445 \u0438\u043C\u044F
                      \u043D\u0435 \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u043B\u043E\u0441\u044C
                      \u0432 \u0441\u043F\u0438\u0441\u043A\u0435 \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043D\u0438\u043A\u043E\u0432
                      \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435 \u0441\u043B\u0435\u0432\u0430."
                    Actions:
                    - rid: -2
                    Buttons: []
                  - Text: "\u041F\u0440\u0438 \u043B\u044E\u0431\u044B\u0445 \u043D\u0435\u0441\u0442\u044B\u043A\u043E\u0432\u043A\u0430\u0445
                      \u0431\u0435\u0440\u0438 \u043A\u0440\u0430\u0441\u043D\u044B\u0439
                      \u0448\u0442\u0430\u043C\u043F \u0438 \u043D\u0430\u043D\u043E\u0441\u0438
                      \u043D\u0430 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442."
                    Actions:
                    - rid: -2
                    Buttons: []
                  - Text: "\u0415\u0441\u043B\u0438 \u0432\u0441\u0451 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E,
                      \u0442\u043E \u0431\u0435\u0440\u0438 \u0437\u0435\u043B\u0435\u043D\u044B\u0439."
                    Actions:
                    - rid: -2
                    Buttons: []
                  - Text: "\u041F\u043E\u043A\u0430 \u043D\u0430 \u044D\u0442\u043E\u043C
                      \u0432\u0441\u0451."
                    Actions:
                    - rid: -2
                    Buttons:
                    - Text: "\u0425\u043E\u0440\u043E\u0448\u043E, \u044F \u0432\u0441\u0435
                        \u043F\u043E\u043D\u044F\u043B."
                      Fragments:
                      - Text: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E, \u0442\u043E\u0433\u0434\u0430
                          \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0430\u0439
                          \u043A \u0440\u0430\u0431\u043E\u0442\u0435!"
                      - Text: "\u0415\u0441\u043B\u0438 \u0447\u0442\u043E-\u0442\u043E
                          \u0437\u0430\u0431\u0443\u0434\u0435\u0448\u044C, \u0442\u043E
                          \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438
                          \u0432 \u0441\u043F\u0440\u0430\u0432\u043E\u0447\u043D\u0438\u043A\u0435
                          \u043D\u0430 \u0441\u0442\u043E\u043B\u0435."
        - Text: "\u041C\u043D\u0435 \u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F\u2026"
          Fragments:
          - Text: "\u0422\u044B \u0441\u043C\u043E\u0442\u0440\u0438 \u0443 \u043C\u0435\u043D\u044F,
              \u043D\u0435 \u0437\u0430\u0437\u043D\u0430\u0432\u0430\u0439\u0441\u044F!"
            Actions:
            - rid: -2
            Buttons:
            - Text: "\u041F\u0440\u043E\u0441\u0442\u0438\u0442\u0435\u2026"
              Fragments:
              - Text: "\u041B\u0430\u0434\u043D\u043E, \u043A\u0430\u043A \u0437\u043E\u0432\u0443\u0442-\u0442\u043E
                  \u0442\u0435\u0431\u044F?"
                Actions:
                - rid: -2
                Buttons:
                - Text: "\u042F \u041E\u0440\u0438\u043E\u043D. \u041E\u0440\u0438\u043E\u043D
                    \u041B\u044C\u044E\u043A\u0441."
                  Fragments:
                  - Text: "\u0417\u043D\u0430\u043A\u043E\u043C\u0430\u044F \u0444\u0430\u043C\u0438\u043B\u0438\u044F\u2026"
                    Actions:
                    - rid: -2
                    Buttons: []
                  - Text: "\u0410 \u043C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442
                      \u041C\u0430\u0440\u043A\u0443\u0441 \u0424\u0440\u0435\u0439."
                    Actions:
                    - rid: -2
                    Buttons: []
                  - Text: "\u0422\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u043B
                      \u2026 (\u043F\u043E\u0432\u0442\u043E\u0440)"
                    Actions:
                    - rid: -2
                    Buttons: []
  GoFragment:
    Text: 
    Actions: []
    Buttons:
    - Text: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
      Fragments: []
  BackFragment:
    Text: 
    Actions: []
    Buttons:
    - Text: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
      Fragments: []
