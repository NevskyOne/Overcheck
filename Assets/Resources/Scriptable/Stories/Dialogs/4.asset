  m_Script: {fileID: 11500000, guid: 3bd342c32fd64e7a8fcb76c9ccf697ea, type: 3}
  m_Name: 4
  m_EditorClassIdentifier: 
  Fragments:
  - Text: "\u0413\u043B\u044F\u044F\u044F \u043A\u0442\u043E \u0442\u0443\u0442 \u0443
      \u043D\u0430\u0441. \u0417\u0434\u043E\u0440\u043E\u0432\u043E, \u043D\u043E\u0432\u0438\u0447\u043E\u043A!"
    Actions:
    - rid: -2
    Buttons: []
  - Text: "\u042F \u0411\u043E\u0440\u0438\u0441, \u043D\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u0438
      \u0442\u0443\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u044E."
    Actions:
    - rid: -2
    Buttons:
    - Text: "\u041E\u0447\u0435\u043D\u044C \u043F\u0440\u0438\u044F\u0442\u043D\u043E,
        \u0430 \u044F \u041E\u0440\u0438\u043E\u043D."
      Fragments:
      - Text: "\u0417\u043D\u0430\u044E, \u0437\u043D\u0430\u044E, \u0441\u043B\u044B\u0445\u0430\u043B
          \u043E \u0442\u0435\u0431\u0435."
        Actions:
        - rid: -2
        Buttons: []
      - Text: "\u041A\u0430\u043A \u0442\u0435\u0431\u0435 \u0440\u0430\u0431\u043E\u0442\u0435\u043D\u043A\u0430-\u0442\u043E?"
        Actions:
        - rid: -2
        Buttons:
        - Text: "\u041F\u043E\u043A\u0430 \u0432\u0441\u0435 \u043E\u0447\u0435\u043D\u044C
            \u043F\u0440\u043E\u0441\u0442\u043E."
          Fragments:
          - Text: "\u041D\u0443 \u0445\u043E\u0440\u043E\u0448\u043E, \u0445\u043E\u0440\u043E\u0448\u043E."
            Actions:
            - rid: -2
            Buttons: []
          - Text: "\u042F \u0442\u0443\u0442 \u043F\u0440\u0438\u0448\u0435\u043B
              \u043A \u0442\u0435\u0431\u0435 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
              \u0442\u0430\u043A! \u0422\u0435\u0431\u0435 \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u043E
              \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E,
              \u0447\u0442\u043E\u0431\u044B \u0442\u044B \u0441\u043B\u0435\u0434\u0438\u043B
              \u0437\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439.
              \u041E\u043D\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
              \u043D\u0430 \u043F\u0435\u0440\u0432\u043E\u043C \u044D\u0442\u0430\u0436\u0435.
              \u041F\u0440\u043E\u0441\u0442\u043E, \u043F\u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0439
              \u0437\u0430 \u043D\u0435\u0439 \u0438\u043D\u043E\u0433\u0434\u0430"
            Actions:
            - rid: 5291054589390094513
            Buttons: []
  GoFragment:
    Text: 
    Actions: []
    Buttons:
    - Text: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
      Fragments: []
  BackFragment:
    Text: 
    Actions: []
    Buttons:
    - Text: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
