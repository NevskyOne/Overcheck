  Fragments:
  - Text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435!
      \u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u043D\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u044E
      \u043C\u0435\u043D\u044F \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430?"
    Actions: []
    Buttons:
    - Text: "\u0421\u0442\u0430\u043D\u0446\u0438\u044E?!"
      Fragments:
      - Text: "\u041E\u0439, \u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0441\u044F...
          \u041D\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0443... \u0425\u0430\u0445,
          \u043A\u043E\u043D\u0435\u0447\u043D\u043E \u043D\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0443"
        Actions: []
        Buttons:
        - Text: "\u0414\u0430 \u043A\u043E\u043D\u0435\u0447\u043D\u043E \u043F\u0440\u043E\u043F\u0443\u0449\u0443,
            \u043C\u043E\u0436\u043D\u043E \u0412\u0430\u0448\u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B?"
          Fragments:
          - Text: "\u0414\u0430 \u0432\u043E\u0442, \u0434\u0435\u0440\u0436\u0438\u0442\u0435..."
            Actions:
            - rid: 8766031492752080910
            Buttons: []
  GoFragment:
    Text: "\u042F \u043F\u043E\u0431\u0435\u0436\u0430\u043B. \u0414\u043E \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F!"
    Actions: []
    Buttons: []
  BackFragment:
    Text: "\u041D\u0443 \u0451\u043B\u043A\u0438-\u0438\u0433\u043E\u043B\u043A\u0438...
      \u041C\u0435\u0434\u043E\u0432\u043E\u0435 \u0440\u0430\u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u0435...
      \u041F\u043E\u0439\u0434\u0443 \u0447\u0442\u043E-\u043B\u0438 \u043C\u0451\u0434\u0430
      \u043F\u043E\u043F\u044C\u044E..."
    Actions: []
    Buttons: []
