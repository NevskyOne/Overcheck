  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3bd342c32fd64e7a8fcb76c9ccf697ea, type: 3}
  m_Name: 17
  m_EditorClassIdentifier: 
  Fragments:
  - Text: "\u041D\u0443 \u0447\u0451, \u043A\u0430\u043A?"
    Actions:
    - rid: 927469285712331001
    Buttons:
    - Text: "\u0427\u0442\u043E \u043A\u0430\u043A?"
      Fragments:
      - Text: "\u0414\u0430 \u043D\u0438\u0447\u0435\u0433\u043E, \u0443 \u0442\u0435\u0431\u044F
          \u0436\u0435 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0438\u043A\u0430\u043A?"
        Actions: []
        Buttons:
        - Text: "\u0427\u0435\u0433\u043E?"
          Fragments:
          - Text: "\u041D\u0443 \u0432\u043E\u0442, \u0447\u0435\u0433\u043E - \u043D\u0438\u0447\u0435\u0433\u043E
              \u044F \u0436\u0435 \u0438 \u0433\u043E\u0432\u043E\u0440\u044E. \u0427\u0442\u043E
              \u043D\u0438\u0447\u0435\u0433\u043E. \u041F\u043E\u043D\u044F\u043B?"
            Actions: []
            Buttons:
            - Text: "\u0427\u0442\u043E \u043A\u0430\u043A?"
              Fragments:
              - Text: "\u041D\u0438\u0447\u0435\u0433\u043E \u0438 \u043D\u0438\u043A\u0430\u043A.
                  \u0421\u043C\u0435\u043A\u0430\u0435\u0448\u044C?"
                Actions: []
                Buttons:
                - Text: "\u041D\u0435\u0430, \u043D\u0435 \u043F\u043E\u043D\u044F\u043B"
                  Fragments:
                  - Text: "\u0417\u0430\u0431\u0435\u0439.... \u041A\u0430\u043A
                      \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043D\u044F\u0442\u044C
                      \u043D\u0438\u0447\u0435\u0433\u043E? \u0412\u0435\u0434\u044C
                      \u0435\u0433\u043E \u0436\u0435 \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
                      \u043D\u0435\u0442..."
                    Actions: []
                    Buttons:
                    - Text: "\u041D\u0443 \u0434\u0430, \u0435\u0433\u043E \u043D\u0435\u0442"
                      Fragments:
                      - Text: "\u041D\u0443 \u0432\u043E\u0442 \u044F \u0438 \u0433\u043E\u0432\u043E\u0440\u044E,
                          \u043A\u0430\u043A \u0442\u0432\u043E\u0451 \u043D\u0438\u0447\u0435\u0433\u043E)
                          \u0420\u043E\u0444\u043B\u044E \u043A\u043E\u0440\u043E\u0447\u0435..."
        - Text: "\u0414\u0430, \u043C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C
            \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E"
          Fragments:
          - Text: "\u041D\u0443, \u0447-\u0447\u0435-\u0441\u0442\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u044F,
              \u044F \u0441\u0430\u043C \u043D\u0435 \u043F\u043E\u043C\u043D\u044E,
              \u0438\u0437-\u0437\u0430 \u0447\u0435-\u0447\u0435-\u0435-\u0433\u043E
              \u044D\u0442\u043E \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C....
              \u041D\u043E \u043F\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043C
              \u043C\u043E\u0435\u0433\u043E \u043F-\u043F-\u043F\u0430\u043F\u044B 
              \u044D\u0442\u043E \u0432\u0441\u0451 \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C,
              \u043A\u043E\u0433\u0434\u0430 \u043C\u043E\u044F \u043C\u043C-\u043C-\u043C\u0430\u043C\u0430
              \u0443\u043C\u0435\u0440\u043B\u0430... \u0412-\u0432--\u0432-\u0432\u0438\u0434\u0438\u043C\u043E
              \u0441\u0442\u0440\u0435\u0441\u0441-\u0441-\u0441 \u043F\u043E\u0432\u043B\u0438\u044F\u043B
              \u0442\u0430\u043A \u043D\u0430 \u043C\u0435\u043D\u044F..."
            Actions: []
            Buttons:
            - Text: "\u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0436\u0430\u043B\u044C
                \u0412\u0430\u0441..."
              Fragments: []
            - Text: "\u0421\u043E\u0436\u0430\u043B\u0435\u044E \u043E \u043F\u043E\u0442\u0435\u0440\u0435..."
              Fragments: []
    - Text: "\u041C\u043E\u0436\u043D\u043E \u0412\u0430\u0448\u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B?"
      Fragments:
      - Text: "\u0414\u0430, \u0432\u043E\u0442. \u0414\u0435\u0440\u0436\u0438..."
        Actions:
        - rid: 8766031492752080906
        Buttons: []
  GoFragment:
    Text: "\u041D\u0443\u0443, \u0434\u0430\u0432\u0430\u0439. \u041D\u0438\u0447\u0435\u0433\u043E
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043D\u0435 \u043C\u043E\u0433\u0443,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u0442\u0435\u0431\u0435 \u043D\u0438\u0447\u0435\u0433\u043E!"
    Actions: []
    Buttons: []
  BackFragment:
    Text: "\u041D\u0438\u0447\u0435\u0433\u043E \u0442\u044B \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C
      \u0432 \u044D\u0442\u043E\u043C... \u041C\u043E\u0433 \u0431\u044B \u0438 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C..."
    Actions: []
    Buttons: []
