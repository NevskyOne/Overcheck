  Fragments:
  - Text: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440! \u0412\u043E\u0442
      \u043C\u043E\u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B.
      \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430
      \u0438\u0445:"
    Actions:
    - rid: 8766031492752080907
    Buttons:
    - Text: "\u0414\u0430, \u043A\u043E\u043D\u0435\u0447\u043D\u043E. \u0421\u0435\u0439\u0447\u0430\u0441
        \u0417\u0430\u0439\u043C\u0443\u0441\u044C"
      Fragments:
      - Text: "\u0425\u043E\u0440\u043E\u0448\u043E. \u0416\u0434\u0443...."
        Actions: []
        Buttons: []
      - Text: "\u0412\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0442\u043E\u0440\u043E\u043F\u0438\u0442\u0435\u0441\u044C....
          \u0430 \u0442\u043E \u044F \u0438\u0442\u0430\u043A \u043E\u043F\u0430\u0437\u0434\u044B\u0432\u0430\u044E...
          \u0432\u043E\u0442 \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E
          \u0442\u0430\u043A \u043D\u0435 \u0437\u0430\u0431\u043E\u0442\u0438\u0442\u044C\u0441\u044F
          \u043E \u043A\u043B\u0438\u0435\u043D\u0442\u0430\u0445..."
        Actions: []
        Buttons: []
      - Text: "\u0411\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E \u043E\u0434\u0435\u043D
          \u043A\u043F\u043F \u043D\u0430 \u0426\u0415\u041B\u0423\u042E \u041F\u041B\u0410\u041D\u0415\u0422\u0423....
          \u0422\u0443\u0442 \u0436\u0443\u0442\u043A\u0438\u0435 \u043E\u0447\u0435\u0440\u0435\u0434\u0438..."
        Actions: []
        Buttons: []
  GoFragment:
    Text: "\u0412\u0441\u0451, \u0441\u043F\u0430\u0441\u0438\u0431\u043E! \u042F
      \u043F\u043E\u0431\u0435\u0436\u0430\u043B... \u0423\u0434\u0430\u0447\u0438!"
    Actions:
    - rid: -2
    Buttons: []
  BackFragment:
    Text: "... \u043C\u043D\u0435 \u0434\u0430\u0436\u0435 \u0441\u043A\u0430\u0437\u0430\u0442\u044C
      \u043D\u0435\u0447\u0435\u0433\u043E... \u042D\u0445..."
    Actions:
    - rid: -2
    Buttons: []
