MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3bd342c32fd64e7a8fcb76c9ccf697ea, type: 3}
  m_Name: 16
  m_EditorClassIdentifier: 
  Fragments:
  - Text: "\u041F\u0440\u0438\u0432\u0435\u0442\u0438\u043A! \u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0448\u044C
      \u043C\u0435\u043D\u044F?"
    Actions:
    - rid: 8766031492752080903
    Buttons:
    - Text: "\u042D\u0445, \u0434\u0430... \u041A\u043E\u043D\u0435\u0447\u043D\u043E.
        \u0422\u043E\u043B\u044C\u043A\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
        \u043C\u043E\u0436\u043D\u043E?"
      Fragments:
      - Text: "\u0422\u0430\u043A \u044F \u0443\u0436\u0435 \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0430.
          \u0422\u044B \u0447\u0442\u043E-\u0442\u043E \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
          \u0433\u0440\u0443\u0441\u0442\u043D\u044B\u0439... \u0427\u0442\u043E-\u0442\u043E
          \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?"
        Actions: []
        Buttons:
        - Text: "\u041D\u0443 \u0447\u0443\u0442\u044C-\u0447\u0443\u0442\u044C...
            \u041E\u0434\u043D\u043E \u0438 \u0442\u043E \u0436\u0435, \u0443\u0441\u0442\u0430\u043B..."
          Fragments:
          - Text: "\u041D\u0443 \u0434\u0430, \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
              \u0432\u0430\u0445\u0442\u0451\u0440\u043E\u043C \u043D\u0435 \u0442\u0430\u043A
              \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F...
              \u041D\u043E \u044F \u0432 \u0446\u0435\u043B\u043E\u043C \u0437\u043D\u0430\u043B\u0430
              \u044D\u0442\u043E... \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0438
              \u043D\u0435 \u0445\u043E\u0447\u0443 \u043D\u0430 \u044D\u0442\u0443
              \u0440\u0430\u0431\u043E\u0442\u0443..."
            Actions: []
            Buttons: []
        - Text: "\u041D\u0443 \u0447\u0443\u0442\u044C-\u0447\u0443\u0442\u044C...
            \u041E\u0434\u043D\u043E \u0438 \u0442\u043E \u0436\u0435, \u0443\u0441\u0442\u0430\u043B..."
          Fragments:
          - Text: "\u041D\u0443 \u0434\u0430, \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
              \u0432\u0430\u0445\u0442\u0451\u0440\u043E\u043C \u043D\u0435 \u0442\u0430\u043A
              \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F...
              \u041D\u043E \u044F \u0432 \u0446\u0435\u043B\u043E\u043C \u0437\u043D\u0430\u043B\u0430
              \u044D\u0442\u043E... \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0438
              \u043D\u0435 \u0445\u043E\u0447\u0443 \u043D\u0430 \u044D\u0442\u0443
              \u0440\u0430\u0431\u043E\u0442\u0443..."
            Actions: []
            Buttons: []
          - Text: "\u0410 \u0442\u044B \u0447\u0435\u0433\u043E \u0442\u0430\u043A?
              \u0440\u0435\u0448\u0438\u043B \u043F\u0440\u043E\u0441\u0442\u043E
              \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
              \u0438\u043B\u0438 \u043D\u0443\u0436\u0434\u0430?"
            Actions: []
            Buttons:
            - Text: "\u041D\u0443\u0436\u0434\u0430, \u044F \u043C\u0430\u043C\u0435
                \u0445\u043E\u0447\u0443 \u0441 \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438
                \u043F\u043E\u043C\u043E\u0447\u044C..."
              Fragments:
              - Text: "\u041F\u043E\u043D\u044F\u043B\u0430 \u0442\u0435\u0431\u044F,
                  \u043D\u0443 \u0443\u0434\u0430\u0447\u043A\u0438 \u0442\u0435\u0431\u0435
                  \u0442\u043E\u0433\u0434\u0430)"
                Actions: []
                Buttons: []
            - Text: "\u041D\u0435 \u0445\u043E\u0447\u0443 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
                \u043D\u0430 \u044D\u0442\u0443 \u0442\u0435\u043C\u0443..."
              Fragments:
              - Text: "\u041E\u043A\u0435\u0439, \u043A\u0430\u043A \u0441\u043A\u0430\u0436\u0435\u0448\u044C...
                  \u0422\u041E\u0433\u0434\u0430 \u043F\u0440\u043E\u0441\u0442\u043E
                  \u043F\u0440\u043E\u0432\u0435\u0440\u044C \u043C\u043E\u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438\u043A\u0438
                  \u0438 \u044F \u0443\u0439\u0434\u0443..."
                Actions: []
                Buttons: []
    - Text: "\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B \u043C\u043E\u0436\u043D\u043E
        \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C?"
      Fragments:
      - Text: "\u0422\u0430\u043A \u044F \u0443\u0436\u0435 \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0430..."
        Actions: []
        Buttons: []
  GoFragment:
    Text: "\u041F\u043E\u043A\u0430-\u043F\u043E\u043A\u0430! \u0421\u043F\u0430\u0441\u0438\u0431\u043E
      \u0442\u0435\u0431\u0435."
    Actions: []
    Buttons: []
  BackFragment:
    Text: "\u0416\u0430\u043B\u044C... \u041E\u0447\u0435\u043D\u044C-\u043E\u0447\u0435\u043D\u044C
      \u0436\u0430\u043B\u044C..."
    Actions:
    - rid: -2
    Buttons: []
  references:
    version: 2
    RefIds:
