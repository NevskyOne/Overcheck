  Fragments:
  - Text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435!
      \u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u043C\u0435\u043D\u044F?
      \u0412\u043E\u0442 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B:"
    Actions:
    - rid: 8766031492752080908
    Buttons:
    - Text: "\u0414\u0430 \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u0441\u0435\u0439\u0447\u0430\u0441
        \u043F\u0440\u043E\u0432\u0435\u0440\u044E \u0442\u043E\u043B\u044C\u043A\u043E..."
      Fragments:
      - Text: "\u0423 \u0412\u0430\u0441 \u0442\u0443\u0442 \u043E\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
          \u043E\u0447\u0435\u0440\u0435\u0434\u0438... \u042F \u0443\u0436\u0435
          6 \u0447\u0430\u0441\u043E\u0432 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
          \u0437\u0434\u0435\u0441\u044C \u043F\u0440\u043E\u0441\u0442\u043E\u044F\u043B\u0430...
          \u0423\u0436\u0430\u0441..."
        Actions: []
        Buttons: []
  GoFragment:
    Text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0412\u0430\u043C, \u0447\u0442\u043E
      \u0442\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0438!
      \u0425\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u0434\u043D\u044F!"
    Actions: []
    Buttons: []
  BackFragment:
    Text: "\u0418 \u0447\u0442\u043E \u0437\u0430 \u0431\u0440\u0435\u0434... \u0422\u043E\u043B\u044C\u043A\u043E
      \u0432\u0440\u0435\u043C\u044F \u0437\u0440\u044F \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B\u0430
      \u0441\u0432\u043E\u0451... "
