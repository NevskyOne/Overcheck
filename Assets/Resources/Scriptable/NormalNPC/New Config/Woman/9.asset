  m_Script: {fileID: 11500000, guid: 3bd342c32fd64e7a8fcb76c9ccf697ea, type: 3}
  m_Name: 9
  m_EditorClassIdentifier: 
  Fragments:
  - Text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439! \u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438
      \u043C\u0435\u043D\u044F \u043A \u043C\u043E\u0435\u0439 \u0441\u0435\u043C\u044C\u0435...
      \u042F \u0441 \u043D\u0438\u043C\u0438 \u0443\u0436\u0435 3 \u0433\u043E\u0434\u0430
      \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430\u0441\u044C..."
    Actions: []
    Buttons:
    - Text: "\u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0442\u0435
        \u0441\u0432\u043E\u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B!"
      Fragments:
      - Text: "\u0412\u043E\u0442, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430.... "
        Actions:
        - rid: 927469285712331003
        Buttons: []
      - Text: "\u042F \u043D\u0435 \u0437\u043D\u0430\u044E, \u043A\u0430\u043A \u0443
          \u043C\u0435\u043D\u044F \u0442\u0430\u043C \u0441 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438,
          \u043F\u043E \u0438\u0434\u0435\u0435 \u0434\u043E\u043B\u0436\u043D\u043E
          \u0431\u044B\u0442\u044C \u0432\u0441\u0451 \u0445\u043E\u0440\u043E\u0448\u043E...
          \u043D\u043E"
        Actions: []
        Buttons: []
      - Text: "\u041A\u0442\u043E \u0437\u043D\u0430\u0435\u0442... \u0412\u0441\u044F\u043A\u043E\u0435
          \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C..."
        Actions: []
        Buttons: []
    - Text: "\u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0442\u0435
        \u0441\u0432\u043E\u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B!"
      Fragments:
      - Text: "\u0415\u0441\u043B\u0438 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0448\u044C,
          \u043C\u043E\u0433\u0443 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
          \u0434\u0430\u0442\u044C \u0432 \u0437\u0430\u043C\u0435\u043D \u0441\u0432\u043E\u0451,
          \u043D\u0443, \u043D\u0435 \u0437\u043D\u0430\u044E, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440
          \u0441\u0435\u043C\u0435\u0439\u043D\u0443\u044E \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044E,
          \u043A\u0443\u043B\u043E\u043D\u0447\u0438\u043A, \u0432\u0435\u0434\u044C
          \u043C\u043D\u0435 \u043F\u0440\u0430\u0432\u0434\u0430 \u043E\u0447\u0435\u043D\u044C
          \u043D\u0443\u0436\u043D\u043E..."
        Actions:
        - rid: 927469285712331003
        Buttons: []
  GoFragment:
    Text: "\u0412\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u043B\u0443\u0447\u0448\u0438\u0439,
      \u0441\u043F\u0430\u0441\u0438\u0431\u043E \u0412\u0410\u041C \u0411\u041E\u041B\u042C\u0428\u041E\u0415!!!!
      \u0412\u043E\u0442, \u0434\u0435\u0440\u0436\u0438 \u043A\u0443\u043B\u043E\u043D\u0447\u0438\u043A"
    Actions:
    - rid: 8766031448645566467
    Buttons:
    - Text: "\u0425\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u0412\u0430\u043C
        \u0434\u043D\u044F!"
      Fragments: []
  BackFragment:
    Text: "\u0414\u0430, \u043D\u0435\u0442... \u041A\u0430\u043A-\u0442\u0430\u043A,
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C... \u0422\u0435\u043F\u0435\u0440\u044C
      \u044F \u043C\u043E\u0433\u0443 \u043D\u0435 \u0443\u0441\u043F\u0435\u0442\u044C...
      \u041E\u0442\u043A\u0443\u0434\u0430 \u0432 \u0442\u0435\u0431\u0435 \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0437\u043B\u043E\u0431\u044B?"
    Actions:
    - rid: -2
    Buttons:
    - Text: "\u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435, \u043D\u043E \u044F
        \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E
        \u043F\u043E \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F\u043C..."
      Fragments: []
