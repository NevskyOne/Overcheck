MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3bd342c32fd64e7a8fcb76c9ccf697ea, type: 3}
  m_Name: 5
  m_EditorClassIdentifier: 
  Fragments:
  - Text: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0434\u0435\u043D\u044C! \u041F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u0435
      \u0437\u0435\u043B\u0451\u043D\u044B\u0439 \u0448\u0442\u0430\u043C\u043F\u0438\u043A?"
    Actions: []
    Buttons:
    - Text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439! \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
        \u043C\u043E\u0433\u0443 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C?"
      Fragments:
      - Text: "\u0412\u043E\u0442, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430..."
        Actions:
        - rid: 927469285712331003
        Buttons: []
      - Text: "\u0422\u0435\u0431\u0435 \u0442\u0443\u0442 \u043D\u0435 \u043E\u0434\u0438\u043D\u043E\u043A\u043E?"
        Actions: []
        Buttons:
        - Text: "\u0410 \u0437\u0430\u0447\u0435\u043C \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0448\u044C?"
          Fragments:
          - Text: "\u0414\u0430, \u0442\u0430\u043A, \u043F\u0440\u043E\u0441\u0442\u043E..."
            Actions: []
            Buttons:
            - Text: "\u042D\u043C, \u043D\u0443 \u043B\u0430\u0434\u043D\u043E..."
              Fragments: []
            - Text: "... *\u043F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u0442\u044C*"
              Fragments: []
        - Text: "\u0414\u0430, \u043E\u0434\u0438\u043D\u043E\u043A\u043E..."
          Fragments:
          - Text: "\u041D\u0443, \u0442\u043E\u0433\u0434\u0430 \u0432\u043E\u0442,
              \u0432\u043E\u0437\u044C\u043C\u0438 \u044D\u0442\u043E\u0433\u043E
              \u043F\u043B\u044E\u0448\u0435\u0432\u043E\u0433\u043E, \u043A\u0430\u043A
              \u0434\u0443\u043C\u0430\u0435\u0448\u044C \u043A\u043E\u0433\u043E?"
            Actions: []
            Buttons: []
          - Text: "\u042D\u0442\u043E\u0433\u043E \u043F\u043B\u044E\u0449\u0435\u0432\u043E\u0433\u043E
              \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430... \u041E\u043D \u0432\u043E\u0442
              \u0442\u0430\u043A\u043E\u0439 \u0432\u043E\u0442 \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u0435\u043D\u044C\u043A\u0438\u0439,
              \u0441\u0442\u043E\u0438\u0442, \u0440\u0443\u043A\u0438 \u0440\u0430\u0437\u0434\u0432\u0438\u043D\u0443\u0432."
            Actions: []
            Buttons: []
          - Text: "\u041D\u043E \u0437\u0430\u0442\u043E, \u0442\u0435\u0431\u0435
              \u0431\u0443\u0434\u0435\u0442 \u0441 \u043D\u0438\u043C \u043F\u043E\u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u0435\u0435,
              \u043D\u0443, \u044F \u043D\u0430\u0434\u0435\u044E\u0441\u044C!"
            Actions:
            - rid: 8766031448645566464
            Buttons:
            - Text: "\u041E\u0443, \u0441\u043F\u0430\u0441\u0438\u0431\u043E\u0447\u043A\u0438!"
              Fragments: []
        - Text: "\u041D\u0435\u0442, \u043D\u0435 \u043E\u0434\u0438\u043D\u043E\u043A\u043E))"
          Fragments:
          - Text: "\u041E-\u043A\u0430\u043A... \u041D\u0443, \u0432\u0438\u0434\u0438\u043C\u043E
              \u043C\u043D\u0435 \u0442\u0435\u0431\u044F \u043D\u0435 \u043F\u043E\u043D\u044F\u0442\u044C...
              \u042F \u0431\u044B \u043D\u0435 \u0441\u043C\u043E\u0433\u043B\u0430
              \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0442\u0443\u0442,
              \u043D\u0430 \u044D\u0442\u043E\u0439 \u0441\u0442\u0430\u043D\u0446\u0438\u0438,
              \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443..."
            Actions: []
            Buttons: []
  GoFragment:
    Text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E\u0447\u043A\u0438! \u042F \u043F\u043E\u0439\u0434\u0443.
      \u0425\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u0412\u0430\u043C \u0434\u043D\u044F))"
    Actions: []
    Buttons: []
  BackFragment:
    Text: "\u042D\u0445, \u0430 \u0447\u0435\u0433\u043E \u0442\u044B \u0442\u0430\u043A...
      \u042F \u0440\u0430\u0437\u0432\u0435 \u0442\u0435\u0431\u0435 \u0447\u0442\u043E-\u0442\u043E
      \u043F\u043B\u043E\u0445\u043E\u0435 \u0441\u0434\u0435\u043B\u0430\u043B\u0430..."
    Actions:
    - rid: -2
    Buttons: []
