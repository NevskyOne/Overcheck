  m_Script: {fileID: 11500000, guid: 3bd342c32fd64e7a8fcb76c9ccf697ea, type: 3}
  m_Name: 4
  m_EditorClassIdentifier: 
  Fragments:
  - Text: "\u0419\u043E\u043E\u043E\u0443! \u0414\u0430\u0440\u043E\u0432\u0430 \u0431\u0440\u043E.
      \u0427\u0451 \u043A\u0430\u043A \u0436\u0438\u0437\u043D\u044C, \u043A\u0430\u043A
      \u0441\u0430\u043C? \u0412\u043E\u0442 \u043C\u043E\u0438 \u0434\u043E\u043A\u0438"
    Actions:
    - rid: 927469285712331006
    Buttons:
    - Text: "\u0414\u0430 \u044F, \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E,
        \u0445\u0430\u0445. \u0410 \u0442\u044B \u043A\u0430\u043A?"
      Fragments:
      - Text: Ye? e vtyz dc` [jhjij/ Z yt edthty ghfdlf? xnj rnj-nj ,eltn xbnfnm
          'njn ntrcn gjkyjcnm./// Yj? lf kflyj///
        Actions: []
        Buttons: []
      - Text: "\u041E\u0439, \u0438\u0437\u0432\u0438\u043D\u0438\u0442\u0435...
          \u0421\u0438\u043D\u0445\u0440\u043E\u043D\u043D\u044B\u0439 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
          \u0437\u0430\u043B\u0430\u0433\u0430\u043B... \u0425\u043E\u0442\u0438\u0442\u0435
          \u043F\u043E\u0434\u0430\u0440\u044E \u0435\u0433\u043E \u0412\u0430\u043C?
          \u0420\u0430\u0437 \u043E\u043D \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
          \u0441\u043B\u043E\u043C\u0430\u043B\u0441\u044F \u0438 \u043B\u0430\u0433\u0430\u0435\u0442?"
        Actions: []
        Buttons:
        - Text: "\u041D\u0443, \u0434\u0430\u0432\u0430\u0439, \u0441\u043F\u0430\u0441\u0438\u0431\u043E"
          Fragments:
          - Text: "\u0412\u043E\u0442, \u0434\u0435\u0440\u0436\u0438. \u041C\u043E\u0436\u0435\u0442
              \u0431\u044B\u0442\u044C \u0442\u0435\u0431\u0435 \u0438 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u044C\u0441\u044F...
              \u0410 \u0442\u043E \u043A\u0430\u043A \u043F\u043E \u043C\u043D\u0435
              \u043E\u043D \u0442\u0430\u043A, \u0441\u0443\u0432\u0435\u043D\u0438\u0440,
              \u043D\u0430 \u043F\u043E\u043B\u043A\u0443 \u0442\u0435\u043F\u0435\u0440\u044C..."
            Actions:
            - rid: 927469285712331008
            Buttons: []
        - Text: "\u0414\u0430 \u043D\u0435, \u0441\u043F\u0430\u0441\u0438\u0431\u043E...
            \u041E\u0431\u043E\u0439\u0434\u0443\u0441\u044C..."
          Fragments: []
  GoFragment:
    Text: "\u041D\u0443 \u0434\u0430\u0432\u0430\u0439\u0442\u0435, \u044F \u043F\u043E\u0433\u043D\u0430\u043B.
      \u0423\u0434\u0430\u0447\u043A\u0438! \u0431\u0431"
    Actions:
    - rid: -2
    Buttons: []
  BackFragment:
    Text: "\u041D\u0443 \u0411\u0411, \u0431\u043E\u043B\u044C\u0448\u0435 \u044F
      \u0441\u044E\u0434\u0430 \u043A \u0442\u0435\u0431\u0435  \u043D\u0435 \u043F\u0440\u0438\u0439\u0434\u0443! "
    Actions:
    - rid: -2
    Buttons: []
