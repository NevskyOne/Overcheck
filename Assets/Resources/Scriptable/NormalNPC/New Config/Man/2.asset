  m_Script: {fileID: 11500000, guid: 3bd342c32fd64e7a8fcb76c9ccf697ea, type: 3}
  m_Name: 2
  m_EditorClassIdentifier: 
  Fragments:
  - Text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0431\u0440\u0430\u0442! \u041A\u0430\u043A
      \u0436\u0438\u0437\u043D\u044C \u043D\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u0438?
      \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0441\u043A\u0443\u043A\u0430
      \u0441\u043C\u0435\u0440\u0442\u043D\u0430\u044F, \u0434\u0430? \u0412\u043E\u0442,
      \u0434\u0435\u0440\u0436\u0438 \u043C\u043E\u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043A\u043D\u0442\u044B
      \u0441\u0440\u0430\u0437\u0443!"
    Actions:
    - rid: 927469285712331004
    Buttons:
    - Text: "\u041D\u0443 \u0434\u0430, \u043D\u043E \u0440\u0430\u0431\u043E\u0442\u0430
        \u0435\u0441\u0442\u044C \u0440\u0430\u0431\u043E\u0442\u0430."
      Fragments:
      - Text: "\u0420\u0430\u0431\u043E\u0442\u0430 \u2013 \u044D\u0442\u043E \u043D\u0435
          \u043A\u0440\u0443\u0442\u043E! \u042F \u0432\u043E\u0442 \u0441\u0435\u0439\u0447\u0430\u0441
          \u043A\u0430\u043A \u0440\u0430\u0437 \u0440\u0435\u0448\u0438\u043B \u0432
          \u043E\u0442\u043F\u0443\u0441\u043A \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F,
          \u043E\u0442 \u0441\u043A\u0443\u043A\u0438 \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C.
          \u0418\u043B\u0438 \u043E\u0442\u0434\u041E\u0445\u043D\u0443\u0442\u044C,
          \u0445\u0430\u0445"
        Actions: []
        Buttons: []
    - Text: "\u041D\u0435 \u0441\u043E\u0433\u043B\u0430\u0448\u0443\u0441\u044C!
        \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430!"
      Fragments:
      - Text: "\u0414\u0430?! \u041D\u0443 \u044F \u0431\u044B \u0442\u043E\u0447\u043D\u043E
          \u043D\u0435 \u0441\u043C\u043E\u0433 \u043D\u0430 \u0442\u0430\u043A\u043E\u0439
          \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C, \u043D\u0435 \u043F\u043E
          \u043C\u043D\u0435 \u044D\u0442\u043E..."
        Actions: []
        Buttons:
        - Text: "\u0410 \u0447\u0442\u043E \u0412\u0430\u043C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E?"
          Fragments:
          - Text: "\u0412\u0441\u044F\u043A\u0438\u0435 \u043A\u0440\u0435\u0430\u0442\u0438\u0432\u043D\u044B\u0435
              \u043F\u0440\u043E\u0444\u0435\u0441\u0438\u0438! \u0414\u0438\u0437\u0430\u0439\u043D\u0435\u0440
              \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440... \u041D\u043E \u043A
              \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E, \u0432\u0441\u0451
              \u043D\u0438\u043A\u0430\u043A \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C\u0441\u044F
              \u043D\u0435 \u043C\u043E\u0433\u0443 \u043D\u0430 \u043D\u0435\u0433\u043E... "
            Actions: []
            Buttons: []
  GoFragment:
    Text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0431\u0440\u043E! \u0415\u0449\u0451
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u0443\u0432\u0438\u0434\u0438\u043C\u0441\u044F.
      \u0411\u044B\u0432\u0430\u0439!"
    Actions:
    - rid: -2
    Buttons: []
  BackFragment:
    Text: "\u0414\u0430 \u0451\u043F\u0440\u0441\u0442.... \u0416\u0430\u043B\u044C..."
    Actions:
    - rid: -2
    Buttons: []
