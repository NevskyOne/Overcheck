MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3bd342c32fd64e7a8fcb76c9ccf697ea, type: 3}
  m_Name: 13
  m_EditorClassIdentifier: 
  Fragments:
  - Text: "\u042D\u0439, \u0431\u0440\u0430\u0442, \u0437\u0434\u0435\u0441\u044C
      \u0432\u043E\u043E\u0431\u0449\u0435 \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442? \u041E\u0447\u0435\u0440\u0435\u0434\u0438
      \u0442\u0430\u043A\u0438\u0435 \u0434\u043B\u0438\u043D\u043D\u044B\u0435...
      \u043F\u0440\u0440\u0444"
    Actions: []
    Buttons:
    - Text: "\u0420\u0430\u0431\u043E\u0442\u0430 \u043D\u0435 \u0432\u043E\u043B\u043A,
        \u0432 \u043B\u0435\u0441 \u043D\u0435 \u0443\u0431\u0435\u0436\u0438\u0442\u2026
        \u0445\u043E\u0442\u044F \u043A\u0442\u043E \u0435\u0451 \u0437\u043D\u0430\u0435\u0442."
      Fragments:
      - Text: "\u0427\u0442\u043E?"
        Actions: []
        Buttons:
        - Text: "\u0414\u0430 \u0442\u0430\u043A, \u0437\u0430\u0431\u0435\u0439"
          Fragments:
          - Text: "\u042D\u043C, \u043D\u0443 \u043B\u0430\u0434\u043D\u043E..."
            Actions: []
            Buttons: []
    - Text: "\u041D\u0443 \u0432\u043E\u043E\u0431\u0449\u0435 \u043D\u0435\u0442,
        \u044F \u043E\u0434\u0438\u043D \u0442\u0443\u0442. \u0427\u0435\u0433\u043E
        \u0412\u0430\u043C?"
      Fragments:
      - Text: "\u041C\u043D\u0435 \u0431\u044B \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u0438\u0442\u044C\u0441\u044F,
          \u0434\u0430 \u043C\u043E\u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C.
          \u0412\u043E\u0442 \u0434\u0435\u0440\u0436\u0438"
        Actions:
        - rid: 8766031492752080898
        Buttons:
        - Text: "\u0410 \u0447\u0442\u043E \u044D\u0442\u043E \u0442\u0430\u043A\u043E\u0435
            \u0443 \u0442\u0435\u0431\u044F?"
          Fragments:
          - Text: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043F\u0430\u0440\u0442\u0438\u044F
              \u043C\u0451\u0434\u0430. \u0414\u043B\u044F \u043B\u0438\u0447\u043D\u043E\u0433\u043E
              \u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u044F."
            Actions: []
            Buttons: []
          - Text: "\u0425\u043E\u0447\u0435\u0448\u044C \u0438 \u0442\u0435\u0431\u0435
              \u043C\u043E\u0433\u0443 \u0431\u0430\u043D\u043E\u0447\u043A\u0443
              \u0434\u0430\u0442\u044C?"
            Actions: []
            Buttons:
            - Text: "\u0414\u0430, \u043D\u0435 \u043E\u0442\u043A\u0430\u0436\u0443\u0441\u044C!"
              Fragments:
              - Text: "\u0412\u043E\u0442 \u0442\u043E\u0433\u0434\u0430, \u0431\u0435\u0440\u0438"
                Actions:
                - rid: 8766031492752080899
                Buttons: []
            - Text: "\u041D\u0435\u0435\u0435, \u0441\u043F\u0430\u0441\u0438\u0431\u043E"
              Fragments:
              - Text: "\u041D\u0443 \u043B\u0430\u0434\u043D\u043E, \u043A\u0430\u043A
                  \u0441\u043A\u0430\u0436\u0435\u0448\u044C..."
                Actions: []
                Buttons: []
  GoFragment:
    Text: "\u041B\u0430\u0434\u043D\u043E, \u0431\u044B\u0432\u0430\u0439 \u0442\u043E\u0433\u0434\u0430!
      \u041F\u043E\u0435\u0434\u0443 \u043A \u0441\u0432\u043E\u0435\u0439 \u0441\u0435\u043C\u044C\u0435.
      \u0423\u0434\u0430\u0447\u0438!"
    Actions:
    - rid: -2
    Buttons: []
  BackFragment:
    Text: "\u0418 \u043A\u0443\u0434\u0430 \u043C\u043D\u0435 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0432\u0435\u0441\u044C \u044D\u0442\u043E\u0442 \u043C\u0451\u0434 \u0434\u0435\u0442\u044C...
      \u042D\u0445... \u041B\u0430\u0434\u043D\u043E, \u0434\u043E \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F..."
    Actions:
    - rid: -2
    Buttons: []
