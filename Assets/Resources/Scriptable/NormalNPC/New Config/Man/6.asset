MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3bd342c32fd64e7a8fcb76c9ccf697ea, type: 3}
  m_Name: 6
  m_EditorClassIdentifier: 
  Fragments:
  - Text: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440, \u0441\u0443\u0434\u0430\u0440\u044C!
      \u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u043C\u0435\u043D\u044F?"
    Actions: []
    Buttons:
    - Text: "\u0414\u043E\u0431\u0440\u044B\u0439. \u0414\u0430\u0432\u0430\u0439\u0442\u0435
        \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B"
      Fragments:
      - Text: "\u0414\u0430, \u043A\u043E\u043D\u0435\u0447\u043D\u043E. \u0412\u043E\u0442:"
        Actions:
        - rid: 8766031448645566465
        Buttons: []
      - Text: "\u041D\u0435 \u043E\u0447\u0435\u043D\u044C \u043A\u043E\u043D\u0435\u0447\u043D\u043E
          \u043C\u043D\u0435 \u043D\u0430 \u044D\u0442\u0443 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u043E\u0432\u043A\u0443
          \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0435\u0445\u0430\u0442\u044C,
          \u043D\u043E, \u0440\u0430\u0431\u043E\u0442\u0430 - \u044D\u0442\u043E
          \u0440\u0430\u0431\u043E\u0442\u0430..."
        Actions: []
        Buttons:
        - Text: "\u0410 \u0447\u0442\u043E \u0443 \u0412\u0430\u0441 \u0437\u0430
            \u0440\u0430\u0431\u043E\u0442\u0430?"
          Fragments:
          - Text: "\u041D\u0443 \u044F \u0434\u043E\u043B\u0436\u0435\u043D \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C
              \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u0440\u0435\u0434\u043A\u0438\u0435
              \u0442\u0440\u0430\u0432\u044B, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0442\u043E\u043C
              \u0438\u0437\u0443\u0447\u0430\u0442\u044C \u0438\u0445 \u0441\u043E\u0441\u0442\u0430\u0432"
            Actions: []
            Buttons: []
          - Text: "\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0435\u0449\u0451
              \u043A\u0430\u043A\u043E\u0439-\u043D\u0438\u0431\u0443\u0434\u044C
              \u043D\u043E\u0432\u044B\u0439 \u0432\u0438\u0434 \u043D\u0430\u0439\u0434\u0443,
              \u0431\u044B\u043B\u043E \u0431\u044B \u043D\u0435 \u043F\u043B\u043E\u0445\u043E,
              \u044D\u0445\u0445"
            Actions: []
            Buttons: []
        - Text: "\u041D\u0443, \u0434\u0430... \u041C\u043D\u0435 \u0442\u043E\u0436\u0435
            \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
            \u043C\u043E\u044F \u0440\u0430\u0431\u043E\u0442\u0430"
          Fragments: []
  GoFragment:
    Text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0441\u0443\u0434\u0430\u0440\u044C.
      \u0414\u043E \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F!"
    Actions: []
    Buttons: []
  BackFragment:
    Text: "\u042D\u0445, \u0441\u0443\u0434\u0430\u0440\u044C-\u0441\u0443\u0434\u0430\u0440\u044C...
      \u041D\u0443 \u043A\u0430\u043A-\u0442\u0430\u043A \u043C\u043E\u0436\u043D\u043E
      \u0442\u043E, \u0430?"
    Actions: []
    Buttons: []
  references:
    version: 2
    RefIds:
    - rid: 8766031448645566465
      type: {class: GiveDocs, ns: , asm: Assembly-CSharp}
