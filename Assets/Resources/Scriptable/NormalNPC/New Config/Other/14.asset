  m_Script: {fileID: 11500000, guid: 3bd342c32fd64e7a8fcb76c9ccf697ea, type: 3}
  m_Name: 14
  m_EditorClassIdentifier: 
  Fragments:
  - Text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
      \u044F \u043A \u0412\u0430\u043C, \u0442\u0430\u043A \u0441\u043A\u0430\u0437\u0430\u0442\u044C,
      \u0441 \u043C\u0438\u0440\u043E\u043C \u0438 \u043C\u0451\u0434\u043E\u043C."
    Actions: []
    Buttons:
    - Text: "\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B \u0434\u0430\u0432\u0430\u0439\u0442\u0435"
      Fragments:
      - Text: "\u0414\u0430 \u0432\u043E\u0442, \u043A\u043E\u043D\u0435\u0447\u043D\u043E!"
        Actions:
        - rid: 8766031492752080900
        Buttons:
        - Text: "\u0410 \u0437\u0430\u0447\u0435\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0435\u0441\u044C?"
          Fragments:
          - Text: "\u041D\u0443 \u044F \u043A\u0430\u043A \u043E\u0431\u044B\u0447\u043D\u044B\u0439
              \u0442\u0443\u0440\u0438\u0441\u0442. \u041F\u043E\u0433\u0443\u043B\u044F\u0442\u044C,
              \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0434\u043E\u0441\u0442\u043E\u043F\u0440\u0438\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438,
              \u0441\u044A\u0435\u0441\u0442\u044C \u043F\u0430\u0440\u0443 \u0441\u043E\u0442\u0435\u043D
              \u043A\u0438\u043B\u043E\u0433\u0440\u0430\u043C\u043C\u043E\u0432
              \u043C\u0451\u0434\u0430. \u041D\u0443, \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442."
            Actions: []
            Buttons: []
  GoFragment:
    Text: "\u0425\u0430\u0445, \u0443\u0434\u0430\u0447\u043A\u0438 \u0442\u0435\u0431\u0435
      \u0442\u0443\u0442 \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F.
      \u041F\u043E\u043A\u0430, \u043D\u0435\u0443\u0434\u0430\u0447\u043D\u0438\u043A!"
    Actions: []
    Buttons: []
  BackFragment:
    Text: "\u041D\u0443 \u0434\u0430, \u043D\u0443 \u0434\u0430... \u041F\u043E\u0448\u0451\u043B
      \u044F \u043E\u0442\u0441\u044E\u0434\u0430 \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435...
      \u041F\u0440\u043E\u0449\u0430\u0439"
    Actions: []
    Buttons: []
  references:
    version: 2
    RefIds:
