  m_Script: {fileID: 11500000, guid: 3bd342c32fd64e7a8fcb76c9ccf697ea, type: 3}
  m_Name: 7
  m_EditorClassIdentifier: 
  Fragments:
  - Text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435-\u0440\u0430\u0440,
      \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435-\u0440\u0430\u0440?
      \u0412\u043E\u0442-\u0440\u0430\u0440, \u043C\u043E\u0438-\u0440\u0430\u0440
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B-\u0440\u0430\u0440."
    Actions:
    - rid: 8766031448645566466
    Buttons:
    - Text: "\u042D\u043C, \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435.
        \u0421\u0435\u0439\u0447\u0430\u0441 \u043F\u0440\u043E\u0432\u0435\u0440\u044E..."
      Fragments: []
    - Text: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E-\u0440\u0430\u0440. \u0421\u0435\u0439\u0447\u0430\u0441-\u0440\u0430\u0440
        \u043F\u0440\u043E\u0432\u0435\u0440\u044E-\u0440\u0430\u0440."
      Fragments:
      - Text: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E-\u0440\u0430\u0440, \u043C\u043D\u0435-\u0440\u0430\u0440
          \u0442\u0430\u043A-\u0440\u0430\u0440 \u043F\u0440\u0438\u044F\u0442\u043D\u043E-\u0440\u0430\u0440,
          \u0447\u0442\u043E-\u0440\u0430\u0440 \u0412\u044B-\u0440\u0430\u0440 \u0442\u0430\u043A\u0436\u0435-\u0440\u0430\u0440,
          \u043A\u0430\u043A-\u0440\u0430\u0440 \u0438-\u0440\u0430\u0440 \u044F-\u0440\u0430\u0440
          \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435-\u0440\u0430\u0440."
        Actions: []
        Buttons: []
  GoFragment:
    Text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E-\u0440\u0430\u0440 \u0412\u0430\u043C-\u0440\u0430\u0440
      \u0431\u043E\u043B\u044C\u0448\u043E\u0435-\u0440\u0430\u0440! \u0414\u043E-\u0440\u0430\u0440
      \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F.zip!"
    Actions:
    - rid: 8766031448645566468
    Buttons: []
  BackFragment:
    Text: "\u041D\u0443-\u0440\u0430\u0440, \u044F-\u0440\u0430\u0440 \u043D\u0435-\u0440\u0430\u0440
      \u0437\u043D\u0430\u044E-\u0440\u0430\u0440, \u043A\u0430\u043A-\u0440\u0430\u0440
      \u044D\u0442\u043E-\u0440\u0430\u0440 \u043F\u0440\u043E\u043A\u043E\u043C\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C-\u0440\u0430\u0440...
      \u0414\u043E-\u0440\u0430\u0440 \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F.zip!"
    Actions:
    - rid: 8766031448645566470
    Buttons: []
