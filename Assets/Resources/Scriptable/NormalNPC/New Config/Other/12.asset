  m_Script: {fileID: 11500000, guid: 3bd342c32fd64e7a8fcb76c9ccf697ea, type: 3}
  m_Name: 12
  m_EditorClassIdentifier: 
  Fragments:
  - Text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435!
      \u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435?"
    Actions: []
    Buttons:
    - Text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435!
        \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430"
      Fragments:
      - Text: "\u0412\u043E\u0442, \u0434\u0435\u0440\u0436\u0438\u0442\u0435"
        Actions:
        - rid: 8766031492752080897
        Buttons: []
      - Text: "\u041A\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u043E \u0432\u044B
          \u0438\u0445 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u0435?"
        Actions: []
        Buttons:
        - Text: "\u041D\u0435 \u0437\u043D\u0430\u044E..."
          Fragments:
          - Text: "\u041D\u0443 \u0431\u043B\u0438\u043D, \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C
              \u0431\u044B \u043F\u043E\u0431\u044B\u0441\u0442\u0440\u0435\u0435...
              \u041D\u043E \u043B\u0430\u0434\u043D\u043E... \u042F \u043F\u043E\u0434\u043E\u0436\u0434\u0443"
            Actions: []
            Buttons: []
        - Text: "\u041F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u043A\u0430\u043A
            \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u0441\u0442\u0440\u0435\u0435..."
          Fragments:
          - Text: "\u041E\u043A\u0435\u0439, \u0441\u043F\u0430\u0441\u0438\u0431\u043E
              \u0412\u0430\u043C \u0431\u043E\u043B\u044C\u0448\u043E\u0435!"
            Actions: []
            Buttons: []
        - Text: "\u0423\u0436\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044E!"
          Fragments:
          - Text: "\u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E! \u0416\u0434\u0443!"
            Actions: []
            Buttons: []
  GoFragment:
    Text: "\u0414\u043E \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F! \u042F
      \u043F\u043E\u0431\u0435\u0436\u0430\u043B, \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E
      \u0412\u0430\u043C \u0434\u043D\u044F!"
    Actions: []
    Buttons: []
  BackFragment:
    Text: "\u041D\u0443 \u043B\u0430\u0434\u043D\u043E, \u044F \u0435\u0449\u0451
      \u0432\u0435\u0440\u043D\u0443\u0441\u044C \u0438 \u0442\u043E\u0433\u0434\u0430,
      \u044F \u0422\u041E\u0427\u041D\u041E \u0441\u043C\u043E\u0433\u0443 \u043F\u0440\u043E\u0439\u0442\u0438..."
    Actions: []
    Buttons: []
  references:
    version: 2
    RefIds:
