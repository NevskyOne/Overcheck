  m_text: "\u0421\u043A\u0430\u043D\u0435\u0440 \u043B\u0438\u0446\u0430 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
    \u0443\u043F\u0440\u043E\u0441\u0442\u0438\u0442\u044C \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443
    \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432 \u0432 \u0440\u0430\u0437\u044B.
    \u041F\u0440\u0438\u043D\u0446\u0438\u043F \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
    \u043E\u0447\u0435\u043D\u044C \u043F\u0440\u043E\u0441\u0442: \u0435\u0441\u043B\u0438
    \u043D\u0430 \u0432\u0441\u0435\u0445 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0445
    \u0444\u043E\u0442\u043E \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u0435\u0442
    \u0441 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u043C, \u0442\u043E \u0441\u043A\u0430\u043D\u0435\u0440
    \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0433\u0430\u043B\u043E\u0447\u043A\u0443,
    \u0438\u043D\u0447\u0430\u0435 \u043A\u0440\u0435\u0441\u0442\u0438\u043A."
