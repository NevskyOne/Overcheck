--- !u!114 &727866464
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 727866453}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f07084a8f3034884852b1fa3157f0afd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _dayStartPhrases:
  - "\u041D\u0443, \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u043C \u043A
    \u0440\u0430\u0431\u043E\u0442\u0435."
  - "\u041D\u0443 \u0447\u0442\u043E-\u0436, \u043D\u0430\u0447\u043D\u0451\u043C."
  _dayEndPhrases:
  - "\u041E\u0445 \u0438 \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u0434\u0435\u043D\u0451\u043A,
    \u043F\u043E\u0439\u0434\u0443 \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u044E
    \u0440\u0430\u0434\u0438\u043E."
  - "\u041E\u043A\u0435\u0439, \u0441 \u0434\u0435\u043B\u0430\u043C\u0438 \u043F\u043E\u043A\u043E\u043D\u0447\u0435\u043D\u043E,
    \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u0442\u044C
    \u043D\u043E\u0432\u043E\u0441\u0442\u0438."
  _eventStartPhrases:
  - "\u041E\u0443, \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E..."
  - "\u041E \u043D\u0435\u0435\u0435\u0435\u0442, \u043E\u043F\u044F\u0442\u044C
    \u0430\u0432\u0430\u0440\u0438\u044F."
  - "\u041E\u043F\u044F\u0442\u044C \u043F\u0443\u0433\u0430\u044E\u0442!"
  _eventDonePhrases:
  - "\u0423\u0440\u0430! \u041C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C
    \u0440\u0430\u0431\u043E\u0442\u0443."
  - "\u0424\u0443\u0445, \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F."
  _strangeVoicePhrases:
  - "\u041E\u043F\u044F\u0442\u044C \u044D\u0442\u043E\u0442 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439
    \u0433\u043E\u043B\u043E\u0441.."
  - "\u0423 \u043C\u0435\u043D\u044F \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435
    \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435."
  _eternityPhrases:
  - "\u041F\u043E\u0441\u0442\u0443\u043F\u0430\u044E \u043B\u0438 \u044F \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E..."
  - "\u0410 \u043C\u043E\u0436\u0435\u0442 \u0432\u0441\u0451 \u0436\u0435 \u043D\u0430\u0434\u043E
    \u0431\u044B\u043B\u043E \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u0442\u044C
    \u0433\u043E\u043B\u043E\u0441 \u0441\u043E\u0432\u0435\u0441\u0442\u0438...?"
